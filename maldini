email = input("Введите email: ")

if "@" in email and "." in email:
    parts = email.split("@")
    
    if len(parts) == 2:
        if parts[0] != "" and parts[1] != "":
            print("Email правильный")
        else:
            print("Ошибка: пустая часть")
    else:
        print("Ошибка: много @")
else:
    print("Ошибка: нет @ или точки")
